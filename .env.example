# --- Variables sensibles / secrètes (ne jamais committer .env) ---
SECRET_KEY=change-me-in-production-min-32-chars
GRAPHHOPPER_API_KEY=

# --- Base de données ---
# Exemple SQLite local : sqlite:///./moto_tracker.db
# Exemple chemin absolu : sqlite:////var/data/moto_tracker.db
DATABASE_URL=sqlite:///./moto_tracker.db
DEFAULT_FUEL_PRICE_PER_LITER=5300.0

# --- Compte de démonstration (créé seulement si table users vide) ---
DEMO_EMAIL=pilote@odomi.app
DEMO_PASSWORD=change-me
DEMO_NAME=Mihaja

# --- Serveur ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
